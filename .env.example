# ==============================================================================
# CLASSROOM AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local overrides, or set these on Render / Railway / Vercel
# ==============================================================================

# Flask Secret Key for session signing
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Server Port (automatically set by Render / Railway)
PORT=5000

# Flask Debug Mode (0 in production, 1 for local development)
FLASK_DEBUG=0

# Backend URL (if frontend on Vercel communicates directly with Render)
# Example: https://classroom-board-ai.onrender.com
BACKEND_URL=

# Upload and temporary processing directories
UPLOAD_FOLDER=./uploads
PIPELINE_OUTPUT_FOLDER=./pipeline_output

# SQLite Database Location
DATABASE_PATH=./database.db

# EasyOCR Model Storage Directory (optional, defaults to ~/.EasyOCR/model or ./model_cache)
EASYOCR_MODEL_DIR=
